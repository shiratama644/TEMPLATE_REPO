{
  "name": "template-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun scripts/check.ts",
    "links": "bun scripts/check-doc-links.ts",
    "mermaid": "bun scripts/check-mermaid.ts",
    "lang": "bun scripts/check-language.ts",
    "agents": "bun scripts/check-agents.ts",
    "index": "bun scripts/check-index.ts",
    "shell": "bun scripts/check-shell.ts",
    "length": "bun scripts/check-function-length.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "build": "bun run typecheck",
    "hooks:install": "bun scripts/install-hooks.ts",
    "github:settings": "bun scripts/github-settings.ts",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip --reporter compact",
    "git:report": "bun scripts/git-report.ts",
    "commit:check": "bun scripts/check-commit.ts",
    "postinstall": "bun scripts/install-hooks.ts --if-git"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@octokit/rest": "22.0.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "agents-md-lint": "1.0.1",
    "conventional-commits-parser": "7.1.3",
    "knip": "6.43.0",
    "simple-git": "4.0.2",
    "typescript": "^6.0.0"
  },
  "patchedDependencies": {
    "agents-md-lint@1.0.1": "patches/agents-md-lint@1.0.1.patch"
  }
}
