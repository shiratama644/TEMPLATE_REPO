{
  "name": "template-repo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "check": "bun scripts/check.ts",
    "links": "bun scripts/check_doc_links.ts",
    "mermaid": "bun scripts/check_mermaid.ts",
    "lang": "bun scripts/check_language.ts",
    "agents": "bun scripts/check_agents.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome check --write .",
    "build": "bun run typecheck",
    "hooks:install": "bun scripts/install_hooks.ts"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.0.0",
    "agents-md-lint": "1.0.1",
    "typescript": "^6.0.0"
  }
}
