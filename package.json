{
  "name": "template-repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Agentによるソフトウェア開発を規律立てて進めるためのテンプレートリポジトリ",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format --write .",
    "test": "vitest",
    "test:unit": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "check": "node --experimental-strip-types scripts/check.ts",
    "check:determinism": "node --experimental-strip-types scripts/check-determinism.ts",
    "check:env": "node --experimental-strip-types scripts/check-env.ts",
    "verify-docs": "node --experimental-strip-types scripts/verify-docs.ts",
    "cspell": "cspell lint --no-progress --show-context --no-must-find-files --dot --gitignore .",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "commit": "cz",
    "prepare": "husky",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "publint": "publint",
    "taze": "taze",
    "taze:major": "taze major",
    "taze:write": "taze -w",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "docker:build": "docker build -t template-repo .",
    "docker:run": "docker run --rm -it -p 3000:3000 template-repo",
    "docker:compose": "docker compose up --build",
    "docker:compose:down": "docker compose down",
    "dev:vite": "pnpm exec vite",
    "dev:next": "pnpm exec next dev",
    "dev:turbo": "pnpm exec turbo dev",
    "dev:watch": "node --watch --experimental-strip-types src/index.ts",
    "build:tsc": "tsc --noEmit && echo \"Build check passed (no output for template)\"",
    "build:vite": "pnpm exec vite build",
    "build:next": "pnpm exec next build",
    "build:turbo": "pnpm exec turbo build",
    "test:robustness": "node --experimental-strip-types _tests_/scripts/robustness.test.ts",
    "test:auto-detect": "node --experimental-strip-types _tests_/scripts/auto-detect.test.ts",
    "test:cache": "node --experimental-strip-types _tests_/scripts/cache-invalidation.test.ts",
    "test:new-repo": "node --experimental-strip-types _tests_/scripts/new-repo.test.ts",
    "test:execute": "node --experimental-strip-types _tests_/scripts/execute.test.ts",
    "test:all-robustness": "pnpm test:robustness && pnpm test:auto-detect && pnpm test:cache && pnpm test:new-repo && pnpm test:execute",
    "test:e2e:template": "node --experimental-strip-types _tests_/scripts/template-e2e.test.ts",
    "test:e2e:all": "pnpm test:all-robustness && pnpm test:e2e:template && pnpm test:setup && pnpm test:bootstrap:improvements",
    "detect": "node --experimental-strip-types -e \"import { detectAll, logDetectionResult } from './scripts/lib/detector.ts'; logDetectionResult(detectAll())\"",
    "setup": "tsx scripts/setup.ts",
    "test:setup": "tsx _tests_/scripts/setup.test.ts",
    "test:bootstrap:improvements": "node --experimental-strip-types _tests_/scripts/bootstrap-improvements.test.ts",
    "create": "node bin/create-template.mjs",
    "dx:check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm publint",
    "dx:update": "pnpm taze && pnpm install",
    "dx:clean": "rm -rf node_modules dist .turbo .next coverage .nyc_output",
    "security:check": "node --experimental-strip-types scripts/check-security.ts",
    "security:audit": "node --experimental-strip-types scripts/check-security.ts --no-secrets --no-licenses",
    "security:secrets": "node --experimental-strip-types scripts/check-security.ts --no-audit --no-licenses",
    "security:licenses": "node --experimental-strip-types scripts/check-security.ts --no-audit --no-secrets",
    "security:sbom": "node --experimental-strip-types scripts/check-security.ts --sbom --no-audit --no-secrets --no-licenses",
    "security:all": "node --experimental-strip-types scripts/check-security.ts --all",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "sbom": "node --experimental-strip-types scripts/check-security.ts --sbom --no-audit --no-secrets --no-licenses",
    "cicd:check": "node --experimental-strip-types scripts/check-cicd.ts",
    "lighthouse": "lhci autorun --config=./lighthouserc.json || lhci autorun",
    "lighthouse:ci": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:collect": "lhci collect --config=./lighthouserc.json",
    "lighthouse:assert": "lhci assert --config=./lighthouserc.json",
    "lighthouse:mobile": "lhci autorun --config=./lighthouserc.json --collect.settings.preset=mobile",
    "lighthouse:desktop": "lhci autorun --config=./lighthouserc.json --collect.settings.preset=desktop",
    "preview": "node --experimental-strip-types scripts/lib/preview.ts",
    "preview:build": "pnpm build && pnpm preview",
    "bundle:analyze": "node --experimental-strip-types scripts/lib/bundle.ts",
    "automerge:check": "node --experimental-strip-types scripts/lib/automerge.ts",
    "test:mutation": "stryker run --configFile stryker.config.json || stryker run",
    "test:mutation:ci": "stryker run --configFile stryker.config.json --logLevel info",
    "test:a11y": "playwright test --grep @a11y --pass-with-no-tests",
    "test:a11y:ci": "playwright test --grep @a11y --pass-with-no-tests --reporter=html",
    "test:visual": "playwright test --grep @visual --pass-with-no-tests --update-snapshots",
    "test:visual:ci": "playwright test --grep @visual --pass-with-no-tests",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "bench": "vitest bench --run",
    "bench:ci": "vitest bench --run --reporter=json --outputFile=bench-results.json",
    "bench:compare": "node --experimental-strip-types scripts/lib/bench.ts --compare",
    "test:property": "vitest run --grep @property --passWithNoTests",
    "test:smoke": "vitest run --grep @smoke --passWithNoTests",
    "quality:all": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm test:a11y --pass-with-no-tests || true && pnpm bench --run || true",
    "quality:mutation": "pnpm test:mutation",
    "quality:a11y": "pnpm test:a11y",
    "quality:visual": "pnpm test:visual:ci",
    "quality:bench": "pnpm bench",
    "type-coverage": "type-coverage --detail --strict --ignore-files \"**/*.test.ts\" --ignore-files \"**/*.spec.ts\" --ignore-files \"e2e/**\"",
    "dep-cruise": "depcruise --config dependency-cruiser.config.cjs src scripts",
    "dep-cruise:ci": "depcruise --config dependency-cruiser.config.cjs src scripts --output-type err-long",
    "jscpd": "jscpd --config jscpd.config.json src scripts",
    "jscpd:ci": "jscpd --config jscpd.config.json src scripts --reporters console,html --output ./reports/jscpd"
  },
  "size-limit": [
    {
      "name": "template core",
      "path": "src/index.ts",
      "limit": "10 kB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched",
      "cspell lint --no-must-find-files --no-progress"
    ],
    "*.{json,jsonc}": [
      "biome check --write --no-errors-on-unmatched",
      "cspell lint --no-must-find-files --no-progress"
    ],
    "*.md": [
      "cspell lint --no-must-find-files --no-progress"
    ],
    "*.{yml,yaml}": [
      "cspell lint --no-must-find-files --no-progress"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@clack/prompts": "^1.8.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "14.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "commitizen": "^4.3.2",
    "consola": "^3.4.2",
    "cspell": "^10.3.4",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "publint": "0.3.24",
    "size-limit": "14.0.1",
    "taze": "21.1.0",
    "tinyglobby": "^0.2.17",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "@lhci/cli": "^0.15.1",
    "lighthouse": "^13.0.0",
    "serve": "^14.2.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.11.0",
    "tinybench": "^6.2.0",
    "fast-check": "^4.3.0",
    "type-coverage": "^2.29.0",
    "dependency-cruiser": "^17.3.0",
    "jscpd": "^4.0.5",
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "@opentui/core": "^0.5.14",
    "@opentui/react": "^0.5.14"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "@puppeteer/browsers": "^3.2.2",
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
