root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{ts,tsx,js,jsx,json,jsonc}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
