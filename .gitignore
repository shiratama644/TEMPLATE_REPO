# Env / secrets
.env
.env.*
!.env.example
!.env.template

# Logs / temp（リポジトリ直下のみ。.agent/logs/ は実行記録として追跡する）
*.log
/logs/
/tmp/
/temp/

# Python（scripts/ の検証スクリプトを import したときに出る生成物）
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Agent personal overrides (official .claude/ equivalent)
.agent/settings.local.json
.claude/settings.local.json

# Agent auto memory (if not committed)
.agent/agent-memory/
.claude/projects/

# Bun / setup
node_modules/
.bun/
.setup-backup/
.setup-pkg-*.tmp
