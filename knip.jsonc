{
  "$schema": "https://unpkg.com/knip@6.43.0/schema.json",
  "entry": ["scripts/*.ts", ".agent/workflows/*.js"],
  "ignore": [
    // External Lace example, not compiled with this repository (imports ~/threads).
    ".agent/skills/systematic-debugging/condition-based-waiting-example.ts"
  ],
  "ignoreDependencies": [
    // scripts/check-agents.ts invokes the patched CLI via an explicit node_modules path.
    "agents-md-lint"
  ]
}
